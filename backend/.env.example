# Project Settings
PROJECT_NAME="AI Job Search & Auto-Apply"
API_V1_STR=/api/v1

# Security (Generate a strong random secret key for production)
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///./sql_app.db

# File Storage
UPLOAD_DIR=./uploads/resumes
MAX_UPLOAD_SIZE_BYTES=10485760

# AI Provider Settings (Optional: OpenRouter)
# If OPENROUTER_API_KEY is not set or empty, the application automatically uses
# the built-in deterministic local heuristic parser without requiring paid APIs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Job Source Settings (Adzuna Global API)
# Register for free developer API keys at https://developer.adzuna.com
# If not provided, the platform automatically uses free official APIs (Arbeitnow, RemoteOK, Jobicy)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Module 4: Email Sending & SMTP Configuration (Optional)
# If not configured, users can still review and one-click copy prepared emails.
# JobPulse AI will never pretend an email was sent if credentials are not configured.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=your_email@example.com
SMTP_TLS=true
EMAIL_PROVIDER=smtp

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
