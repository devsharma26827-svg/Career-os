# ==============================================================================
# JobPulse AI - Master Environment Configuration Template (.env.example)
# ==============================================================================
# This template outlines all configurable environment variables across the project.
#
# Backend configuration lives in:   backend/.env
# Frontend configuration lives in:  New Frontend/.env
#
# To get started:
#   1. Copy backend/.env.example to backend/.env
#   2. Copy "New Frontend/.env.example" to "New Frontend/.env"
# ==============================================================================

# --- BACKEND SETTINGS (backend/.env) ---

PROJECT_NAME="JobPulse AI"
API_V1_STR=/api/v1

# Security & Session Authentication
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database Connection (Default: Local SQLite)
DATABASE_URL=sqlite:///./sql_app.db

# File Storage
UPLOAD_DIR=./uploads/resumes
MAX_UPLOAD_SIZE_BYTES=10485760

# AI Provider Settings (OpenRouter / Fallback Heuristic)
# If OPENROUTER_API_KEY is omitted, JobPulse AI automatically runs with its
# deterministic offline heuristic parser without failing or requiring payment.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Job Source Credentials (Adzuna Global Search)
# Register at https://developer.adzuna.com for worldwide regional listings.
# If omitted, JobPulse AI discovers jobs via Arbeitnow, RemoteOK, and Jobicy.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional Outbound SMTP Email Dispatch
# If unconfigured, JobPulse AI prepares honest one-click copyable drafts
# and will never claim an email was dispatched externally without credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=your_email@example.com
SMTP_TLS=true
EMAIL_PROVIDER=smtp

# Allowed CORS Origins (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# --- FRONTEND SETTINGS (New Frontend/.env) ---

VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
GEMINI_API_KEY=""
APP_URL="http://localhost:5173"
